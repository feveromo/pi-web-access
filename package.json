{
  "name": "pi-web-access",
  "version": "0.10.8",
  "description": "Keyless local-first web research via self-hosted SearXNG, docs/API search, GitHub examples, URL fetching, PDF extraction, and scholarly research for Pi coding agent",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "syntax": "find . -maxdepth 1 -name '*.ts' -print | sort | xargs -n1 node --check",
    "pack:dry-run": "npm pack --dry-run",
    "scan:sensitive": "node scripts/scan-sensitive.mjs",
    "check": "npm run syntax && npm test && npm run scan:sensitive && npm run pack:dry-run"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "web-search",
    "fetch",
    "scraping"
  ],
  "author": "Nico Bailon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feveromo/pi-web-access.git"
  },
  "bugs": {
    "url": "https://github.com/feveromo/pi-web-access/issues"
  },
  "homepage": "https://github.com/feveromo/pi-web-access#readme",
  "files": [
    "*.ts",
    "scripts/scan-sensitive.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.16.0",
    "p-limit": "^6.1.0",
    "turndown": "^7.2.0",
    "unpdf": "^1.6.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6"
  }
}
